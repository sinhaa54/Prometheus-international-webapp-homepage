# ---- Application ----
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api
API_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Repositories ----
# Use "local" for the synthetic JSON dataset (dev / offline).
# Use "dataiku" for the Dataiku-managed dataset (production).
DASHBOARD_REPOSITORY_MODE=local
DATAIKU_DATASET_NAME=PROMETHEUS_DASHBOARDS

SUBMISSION_REPOSITORY_MODE=local
SUBMISSION_DATASET_NAME=PROMETHEUS_SUBMISSIONS

# ---- Caching / pagination ----
DASHBOARD_CACHE_TTL_SECONDS=60
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500

# ---- Tableau redirection ----
# Comma-separated allowlist of approved Tableau hostnames.
# Only HTTPS URLs whose hostname EXACTLY matches one of these are opened.
ALLOWED_TABLEAU_HOSTS=tableau.pfizer.com,tableau-internal.pfizer.com
TABLEAU_OPEN_IN_NEW_TAB=true

# ---- Access-request catalog ----
# Hosts allowed for external "Get access" form URLs. Typically Office Forms
# wrapped by Pfizer's urldefense.com link protection.
ALLOWED_ACCESS_REQUEST_HOSTS=forms.office.com,urldefense.com

# Uniform accent color for category chips (mockup calls for #3B9EDE).
CATEGORY_ACCENT=#3B9EDE

# ---- External support links (surface on the header) ----
# "Contact us" is a mailto link; "Feedback" is an external Office Forms URL
# (wrapped by urldefense.com). The frontend never posts to the backend for
# these anymore - the buttons open external destinations directly.
CONTACT_MAILTO=mailto:analytics@pfizer.com?subject=Prometheus%20%E2%80%94%20Analytics%20query
FEEDBACK_URL=https://urldefense.com/v3/__https://forms.office.com/r/prometheus-feedback__;!!H9nueQsQ!7jrYacdyITfZT9tF-SC_AmuAGnlhlRJG1WufBVZxkkuDCXiEO3TM2IkbafmLCfXDn66e8PHeyHduLxTpDkr7BA$

# ---- Dataiku base-path (webapp hosted under non-root URL) ----
# Example: /public-webapps/PROJECT/PROMETHEUS/
DATAIKU_BASE_PATH=/
